#!/usr/bin/env bash
# Launch Diffary.app detached from this terminal. Paths become absolute
# because the app's working directory isn't this shell's.
set -euo pipefail
APP="${DIFFARY_APP:-$HOME/Applications/Diffary.app}"
BIN="$APP/Contents/MacOS/Diffary"

abs() { (cd "$(dirname "$1")" && printf '%s/%s' "$(pwd)" "$(basename "$1")"); }

out=()
have_repo=0
while (($#)); do
  case "$1" in
    -h|--help|--version) exec "$BIN" "$1" ;;
    --config) out+=(--config "$(abs "$2")"); shift 2 ;;
    --config=*) out+=(--config "$(abs "${1#--config=}")"); shift ;;
    --base|--set) out+=("$1" "$2"); shift 2 ;;
    -*) out+=("$1"); shift ;;
    *) out+=("$(cd "$1" && pwd)"); have_repo=1; shift ;;
  esac
done
((have_repo)) || out=("$PWD" ${out[@]+"${out[@]}"})
exec open -n -a "$APP" --args "${out[@]}"
